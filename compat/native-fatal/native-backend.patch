+/* Current-LWP query usable before native enqueue, including under a Linux
+ * queue interlock. sigispending's current+LW_PENDSIG contract permits this
+ * lockless query; native group exit/core flags are explicit fatal events.
+ */
+bool
+sleepq_fatal_pending(lwp_t *l)
+{
+    unsigned int flag;
+
+    KASSERT(l == curlwp);
+    flag = atomic_load_relaxed(&l->l_flag);
+    if ((flag & (LW_WEXIT | LW_WCORE)) != 0)
+        return true;
+    return (flag & LW_PENDSIG) != 0 && sigispending(l, SIGKILL) != 0;
+}
