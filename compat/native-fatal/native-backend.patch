 /*
+ * Native signal-post eligibility, with the LWP/queue locked. A fatal CV
+ * stays catchable for native exit/core handling, but ordinary posted signals
+ * neither dequeue it nor choose it as a signal recipient.
+ */
+bool
+sleepq_sigwake_allowed(lwp_t *l, int sig)
+{
+    KASSERT(lwp_locked(l, NULL));
+    if ((l->l_flag & LW_SINTR) == 0)
+        return false;
+    return (l->l_syncobj->sobj_flag & SOBJ_SIGKILL) == 0 || sig == SIGKILL;
+}
