 /*
+ * Borrow the native descriptor only while acquiring a separately owned
+ * Linux-file reference. Native close cannot destroy f_data during this call.
+ * The callback must retain before returning; fd_putfile releases only the
+ * native descriptor reference, not the returned Linux-file ownership.
+ */
+struct linux_file *
+fd_get_linux_file(unsigned fd)
+{
+	struct linux_file *linux_file = NULL;
+	file_t *fp;
+
+	fp = fd_getfile(fd);
+	if (fp == NULL)
+		return NULL;
+	if (fp->f_ops->fo_linux_file != NULL)
+		linux_file = (*fp->f_ops->fo_linux_file)(fp);
+	fd_putfile(fd);
+	return linux_file;
+}
