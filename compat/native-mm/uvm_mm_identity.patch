+struct vmspace;
+struct uvmspace_runtime_ops {
+	/* Native vm_refcnt is already zero; no new users can enter.
+	 * Called with vm_runtime_lock held, before any native storage
+	 * is freed.  Clear vm_runtime and vm_runtime_ops on return. */
+	void (*uro_release)(struct vmspace *);
+	/* Optional code-owner counter. Native increments before the
+	 * callback can retire its last object, and decrements only
+	 * after callback return, without touching the ops again. */
+	volatile unsigned int *uro_calls;
+};
