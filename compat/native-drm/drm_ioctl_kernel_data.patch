+long drm_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
+{
+	return drm_ioctl_dispatch(filp, cmd, arg, NULL, NULL);
+}
 EXPORT_SYMBOL(drm_ioctl);
+
+#ifdef __NetBSD__
+/* The native boundary owns exactly _IOC_SIZE(cmd) bytes.  Never
+ * dispatch directly into that buffer: the canonical driver ABI
+ * may be larger.  The shared dispatcher retains all frozen lookup,
+ * permission, unplug, zero-extension and output-on-error rules.
+ */
+long drm_ioctl_kernel_data(struct file *filp, unsigned int cmd,
+			   void *data, unsigned int *out_size)
+{
+	if (!out_size)
+		return -EINVAL;
+	*out_size = 0;
+	if (_IOC_SIZE(cmd) && !data)
+		return -EINVAL;
+	return drm_ioctl_dispatch(filp, cmd, 0, data, out_size);
+}
+EXPORT_SYMBOL(drm_ioctl_kernel_data);
+#endif
 
