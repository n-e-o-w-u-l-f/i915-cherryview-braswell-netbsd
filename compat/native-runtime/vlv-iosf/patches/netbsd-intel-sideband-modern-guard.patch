+
+/*
+ * Modern IOSF numbering is distinct from the legacy VLV enum.
+ * Keep existing values untouched; modern PUNIT=8, DPIO_2=4.
+ */
+enum nb_i915_iosf_unit {
+	NB_I915_IOSF_BUNIT = 0,
+	NB_I915_IOSF_CCK = 1,
+	NB_I915_IOSF_CCU = 2,
+	NB_I915_IOSF_DPIO = 3,
+	NB_I915_IOSF_DPIO2 = 4,
+	NB_I915_IOSF_FLISDSI = 5,
+	NB_I915_IOSF_GPIO = 6,
+	NB_I915_IOSF_NC = 7,
+	NB_I915_IOSF_PUNIT = 8,
+};
+
+/* Caller initializes guard to {0}; same context must release it. */
+struct nb_i915_iosf_guard {
+	struct drm_i915_private *owner;
+	unsigned long units;
+};
+int nb_i915_iosf_acquire(struct drm_i915_private *,
+    unsigned long, struct nb_i915_iosf_guard *);
+int nb_i915_iosf_release(struct nb_i915_iosf_guard *);
+int nb_i915_iosf_read_checked(struct nb_i915_iosf_guard *,
+    unsigned int, u32, u32 *);
+int nb_i915_iosf_write_checked(struct nb_i915_iosf_guard *,
+    unsigned int, u32, u32);
 
 void vlv_iosf_sb_get(struct drm_i915_private *i915, unsigned long ports);
 u32 vlv_iosf_sb_read(struct drm_i915_private *i915, u8 port, u32 reg);
