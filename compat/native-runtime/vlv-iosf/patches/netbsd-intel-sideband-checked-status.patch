+/*
+ * Expose the existing serialized IOSF mailbox's error status to the
+ * modern display callback adapter. Existing void ABI stays intact.
+ * Caller must own i915->sb_lock and the PUNIT reservation where needed.
+ */
+int
+nb_i915_vlv_iosf_rw_checked(struct drm_i915_private *i915,
+    u32 devfn, u32 port, u32 opcode, u32 addr, u32 *val)
+{
+    if (val == NULL || port == 0)
+        return -EINVAL;
+    switch (opcode) {
+    case SB_MRD_NP:
+    case SB_MWR_NP:
+    case SB_CRRDDA_NP:
+    case SB_CRWRDA_NP:
+        break;
+    default:
+        return -EINVAL;
+    }
+    return vlv_sideband_rw(i915, devfn, port, opcode, addr, val);
+}
