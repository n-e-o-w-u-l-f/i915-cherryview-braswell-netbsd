--- a/netbsd/sys/external/bsd/drm2/dist/drm/drm_connector.c
+++ b/netbsd/sys/external/bsd/drm2/dist/drm/drm_connector.c
@@ -38,6 +38,9 @@
 #include "drm_crtc_internal.h"
 #include "drm_internal.h"
 
