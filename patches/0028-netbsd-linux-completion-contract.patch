+/* Lock acquisition also drains an in-flight complete() before returning. */
+static inline bool
+completion_done(struct completion *completion)
+{
+    bool done;
+    mutex_enter(&completion->c_lock);
+    done = completion->c_done != 0;
+    mutex_exit(&completion->c_lock);
+    return done;
+}
 
