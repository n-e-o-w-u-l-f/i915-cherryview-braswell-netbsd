From: NEOWULF Cherryview parity work
Subject: [PATCH] i915/chv: restore full PPGTT and program Gen8 PDPs

Reference: Linux commit 1c8ee8b92fb6ac9d5975147cc902e8c142eca338
Baseline: NetBSD 11 i915 imported from Linux v5.6-rc3
          f8788d86ab28f61f7b46eb6be375f8a726783636

Cherryview was changed upstream from aliasing PPGTT back to full PPGTT.
For 32-bit (3-level) Gen8 PPGTT contexts the PDP registers must be
programmed explicitly in the request before the normal invalidate.
The required primitives already exist in the NetBSD v5.6-derived i915
tree, including GEN8_3LVL_PDPES, i915_page_dir_dma_addr(),
i915_vm_is_4lvl(), GEN8_RING_PDP_{U,L}DW and MI_LRI_FORCE_POSTED.

This is a hardware-semantics backport.  NetBSD bus-DMA translation stays
inside the existing i915_page_dir_dma_addr()/px_dma abstraction.

diff --git a/sys/external/bsd/drm2/dist/drm/i915/i915_pci.c b/sys/external/bsd/drm2/dist/drm/i915/i915_pci.c
--- a/sys/external/bsd/drm2/dist/drm/i915/i915_pci.c
+++ b/sys/external/bsd/drm2/dist/drm/i915/i915_pci.c
@@
 	.has_logical_ring_contexts = 1,
 	.display.has_gmch = 1,
-	.ppgtt_type = INTEL_PPGTT_ALIASING,
+	.ppgtt_type = INTEL_PPGTT_FULL,
 	.ppgtt_size = 32,
 	.has_reset_engine = 1,
 	.has_snoop = true,
diff --git a/sys/external/bsd/drm2/dist/drm/i915/gt/intel_lrc.c b/sys/external/bsd/drm2/dist/drm/i915/gt/intel_lrc.c
--- a/sys/external/bsd/drm2/dist/drm/i915/gt/intel_lrc.c
+++ b/sys/external/bsd/drm2/dist/drm/i915/gt/intel_lrc.c
@@
 static int gen8_emit_init_breadcrumb(struct i915_request *rq)
 {
 	u32 *cs;
@@
 	return 0;
 }
 
+static int emit_pdps(struct i915_request *rq)
+{
+	const struct intel_engine_cs * const engine = rq->engine;
+	struct i915_ppgtt * const ppgtt = i915_vm_to_ppgtt(rq->context->vm);
+	int err, i;
+	u32 *cs;
+
+	GEM_BUG_ON(intel_vgpu_active(rq->i915));
+
+	/*
+	 * This ordering is required on Gen8 3-level PPGTT.  Preserve the
+	 * upstream sequence exactly: flush residual context-load work,
+	 * invalidate, load all four PDP pairs with posted LRI semantics,
+	 * then let the normal request invalidate continue.
+	 */
+	err = engine->emit_flush(rq, EMIT_FLUSH);
+	if (err)
+		return err;
+
+	err = engine->emit_flush(rq, EMIT_INVALIDATE);
+	if (err)
+		return err;
+
+	cs = intel_ring_begin(rq, 4 * GEN8_3LVL_PDPES + 2);
+	if (IS_ERR(cs))
+		return PTR_ERR(cs);
+
+	*cs++ = MI_LOAD_REGISTER_IMM(2 * GEN8_3LVL_PDPES) |
+	    MI_LRI_FORCE_POSTED;
+	for (i = GEN8_3LVL_PDPES; i--; ) {
+		const dma_addr_t pd_daddr = i915_page_dir_dma_addr(ppgtt, i);
+		u32 base = engine->mmio_base;
+
+		*cs++ = i915_mmio_reg_offset(GEN8_RING_PDP_UDW(base, i));
+		*cs++ = upper_32_bits(pd_daddr);
+		*cs++ = i915_mmio_reg_offset(GEN8_RING_PDP_LDW(base, i));
+		*cs++ = lower_32_bits(pd_daddr);
+	}
+	*cs++ = MI_NOOP;
+
+	intel_ring_advance(rq, cs);
+
+	return 0;
+}
+
 static int execlists_request_alloc(struct i915_request *request)
 {
 	int ret;
@@
 	 * golden renderstate above. Think twice before you try
 	 * to cancel/unwind this request now.
 	 */
 
+	if (!i915_vm_is_4lvl(request->context->vm)) {
+		ret = emit_pdps(request);
+		if (ret)
+			return ret;
+	}
+
 	/* Unconditionally invalidate GPU caches and TLBs. */
 	ret = request->engine->emit_flush(request, EMIT_INVALIDATE);
 	if (ret)
