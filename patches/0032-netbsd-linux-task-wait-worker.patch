+#define wait_event_freezable_timeout(wq_head, condition, timeout)		\
+({										\
+	long __linux_wait_event_freezable_timeout_ret = timeout;							\
+	might_sleep();								\
+	if (!___wait_cond_timeout(condition, __linux_wait_event_freezable_timeout_ret))					\
+		__linux_wait_event_freezable_timeout_ret = __wait_event_freezable_timeout(wq_head, condition, timeout); \
+	__linux_wait_event_freezable_timeout_ret;									\
+})
+
+#define __wait_event_exclusive_cmd(wq_head, condition, cmd1, cmd2)		\
+	(void)___wait_event(wq_head, condition, TASK_UNINTERRUPTIBLE, 1, 0,	\
+			    cmd1; schedule(); cmd2)
