+#define wait_event_timeout(wq_head, condition, timeout)				\
+({										\
+	long __linux_wait_event_timeout_ret = timeout;							\
+	might_sleep();								\
+	if (!___wait_cond_timeout(condition, __linux_wait_event_timeout_ret))					\
+		__linux_wait_event_timeout_ret = __wait_event_timeout(wq_head, condition, timeout);	\
+	__linux_wait_event_timeout_ret;									\
+})
