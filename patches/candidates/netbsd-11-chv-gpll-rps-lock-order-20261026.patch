+/*
+ * VLV/CHV GPLL reference clock, adapted from Linux vlv_clock_get_gpll().
+ * Use the native IOSF CCK transaction lock for both clock reads.
+ * The modern CZCLK path caches its value; only bootstrap it when absent.
+ */
+int
+vlv_get_gpll_clock(struct drm_i915_private *dev_priv)
+{
+	int gpll;
+
+	vlv_cck_get(dev_priv);
+	if (dev_priv->czclk_freq == 0) {
+		if (dev_priv->hpll_freq == 0)
+			dev_priv->hpll_freq = vlv_get_hpll_vco(dev_priv);
+		dev_priv->czclk_freq = vlv_get_cck_clock(dev_priv, "czclk",
+		    CCK_CZ_CLOCK_CONTROL, dev_priv->hpll_freq);
+	}
+	gpll = vlv_get_cck_clock(dev_priv, "GPLL ref",
+	    CCK_GPLL_CLOCK_CONTROL, dev_priv->czclk_freq);
+	vlv_cck_put(dev_priv);
+	return gpll;
+}
