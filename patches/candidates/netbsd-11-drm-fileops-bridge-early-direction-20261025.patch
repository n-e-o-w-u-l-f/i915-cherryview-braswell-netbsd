-/*
- * Look up the file structure corresponding to a file descriptor
- * and return it with a reference held on the file, not the
- * descriptor.
+/*
+ * Acquire a separately owned Linux reference under a native fd_getfile
+ * descriptor pin.  The fo_linux_file callback must get a strong Linux
+ * reference BEFORE fd_putfile; the recipient owns a matching Linux fput.
+ */
+struct linux_file *
+fd_get_linux_file(unsigned fd)
+{
+	file_t *fp;
+	struct linux_file *linux = NULL;
+
+	fp = fd_getfile(fd);
+	if (fp == NULL)
+		return NULL;
+	if (fp->f_ops != NULL && fp->f_ops->fo_linux_file != NULL)
+		linux = (*fp->f_ops->fo_linux_file)(fp);
+	fd_putfile(fd);
+	return linux;
+}
