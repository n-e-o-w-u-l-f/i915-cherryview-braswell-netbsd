+static void uncore_mmio_cleanup(struct intel_uncore *uncore)
+{
+	struct pci_dev *pdev = uncore->i915->drm.pdev;
+
+#ifdef __NetBSD__
+	/* Borrowed AGP mappings belong to the AGP driver, not pci_iomap(). */
+	const unsigned int mmio_bar = IS_GEN(uncore->i915, 2) ? 1 : 0;
+	if (!pdev->pd_resources[mmio_bar].mapped)
+		return;
+#endif
+	pci_iounmap(pdev, uncore->regs);
+}
 
