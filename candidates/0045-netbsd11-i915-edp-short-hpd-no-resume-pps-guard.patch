+/*
+ * Read the eDP PPS state only while its AUX power domain is already active.
+ * Do not runtime-resume a powered-off panel merely to service a short HPD.
+ * Mirror pps_lock() ordering: AUX power reference before pps_mutex.
+ */
+static bool intel_dp_edp_hpd_panel_powered(struct intel_dp *intel_dp)
+{
+	struct drm_i915_private *dev_priv = dp_to_i915(intel_dp);
+	enum intel_display_power_domain domain =
+		intel_aux_power_domain(dp_to_dig_port(intel_dp));
+	intel_wakeref_t wakeref;
+	bool powered;
+
+	wakeref = intel_display_power_get_if_enabled(dev_priv, domain);
+	if (!wakeref)
+		return false;
+
+	mutex_lock(&dev_priv->pps_mutex);
+	powered = edp_have_panel_power(intel_dp) ||
+		  edp_have_panel_vdd(intel_dp);
+	mutex_unlock(&dev_priv->pps_mutex);
+
+	intel_display_power_put(dev_priv, domain, wakeref);
+	return powered;
+}
